% --- Notational house style ---------------------------------------------
% Two families, kept visually distinct on purpose:
%
%   BOLD    a named ambient category:  \Cat \Set \Cube \Braid \List
%   UPRIGHT a construction applied to an object, or an operator:
%           \Ch(K)  \Chs(K)  \Run(K)  \Edge(K)  \Lines(K)  \Refine(K)
%           \Coord  \Sal(n)  \Face(n) \Tope     \Conc(K)   \Inv(\sigma)
%
% Functors are written with \to, never \Rightarrow (which is reserved for
% natural transformations).
%
% The symbol \square and its decorations ALWAYS mean a category of
% precubical sets, never a cube.  The standard n-cube is \cube{n} = I^n.

% Named categories (bold).
\newcommand{\Cat}{\mathbf{Cat}}
\newcommand{\Set}{\mathbf{Set}}
\newcommand{\Cube}{\mathbf{Cube}}               % the box category
\newcommand{\Braid}{\mathbf{Braid}}             % objects N, Hom(n,n) = B_n
\newcommand{\BraidPos}{\mathbf{Braid}^{+}}      % objects N, Hom(n,n) = B_n^+
\newcommand{\List}{\mathbf{List}}

% --- Project notation ---------------------------------------------------
% Cube-chains / precubical notation lives here so every section subfile
% shares it. This block is expected to grow as the paper does; keep new
% notation together and documented with a short comment.
%
%   \cube{n}  standard n-cube, I^n           \pSet   precubical sets
%   \BPSet    bipointed precubical sets      \Wdg    serial wedges
%   \Ch       cube chains                    \Chs    their complexification
%   \Run      runs (1-dimensional chains)    \Edge   their cell-list form
%
\newcommand{\cube}[1]{I^{#1}}
\newcommand{\pSet}{\square}                     % presheaves on \Cube
\newcommand{\BPSet}{\square_{*}}                % bipointed precubical sets
\newcommand{\Wdg}{\square^{\vee}}               % full subcat of serial wedges

\DeclareMathOperator{\Ch}{Ch}
\DeclareMathOperator{\Br}{Br}
\DeclareMathOperator{\Chs}{Ch^*}
\DeclareMathOperator{\Refine}{Refine}
\DeclareMathOperator{\Run}{Run}
\DeclareMathOperator{\Edge}{Edge}
\DeclareMathOperator{\Lines}{Lines}
\DeclareMathOperator{\Coord}{Coord}
\DeclareMathOperator{\Conc}{Conc}

% The summand index of a coordinate: the first component of an element of
% \coprod_i [a_i].  Overloaded onto wedge maps for the induced map on summand
% indices, characterised by naturality  blk(f_*(c)) = blk(f)(blk(c)).
% Matches `blockIdx` in the Lean development.
\DeclareMathOperator{\blk}{blk}
\DeclareMathOperator{\normalize}{norm}          % delete 0-cells from a chain

% Bipointed structure maps.
\DeclareMathOperator{\init}{init}
\DeclareMathOperator{\fin}{fin}
\DeclareMathOperator{\alt}{alt}

% Hyperplane-arrangement side.
\DeclareMathOperator{\Face}{Face}
\DeclareMathOperator{\Tope}{Tope}
\DeclareMathOperator{\Sal}{Sal}
\DeclareMathOperator{\Conf}{Conf}               % ordered configuration space
\DeclareMathOperator{\UConf}{UConf}             % unordered, matching PZ's notation

% Directed topology.  \dP(K) is the space of directed paths on |K|; the
% decoration \dP(K)_0^1 is PZ's space of d-paths from init to fin.
\newcommand{\dP}{\vec{P}}

% The free groupoid on a category (localisation at all morphisms).
\DeclareMathOperator{\Free}{Free}

% Permutations: \Inv is the inversion set, \ell its cardinality (Coxeter
% length).  Do NOT use i(-) for the inversion set: i is an index everywhere.
\DeclareMathOperator{\Inv}{Inv}

% --- Diagram styles -----------------------------------------------------
% Some maps we draw are illustrative annotations, not morphisms of the
% ambient category: the permutation \sigma(f), the run action E(\rho)(f),
% and the face projection \hat f. Draw them dashed so they read as
% "not an arrow of this category".
\tikzset{
  perm/.style   = {dashed},  % \sigma(f): a permutation
  runact/.style = {dashed},  % E(\rho)(f) / \hat f: the run action
}

% --- mainv2: squares, runs over a chain, polygraphs ----------------------
% Events of a shape on N are identified with [N], so a shape is an interval
% partition of [N] and enters only through its block map \blk.  Vocabulary:
%
%   \blk    the block an event lies in     \Sq(d)   the squares of a chain
%   \Cross  the squares a map crosses      \Steps   the steps of a run over d
%   \Cell_n the n-cells                    \Art(K)  the Artin polygraph of K
%   \pres{P} the category P presents       \ArtBraid  Artin's braid polygraph
%   \dom    the source of an arrow
%
% The only decorations are \bot_d, \top_d (least/greatest in a poset) and x^s
% (the flip of x at s).  No bars, no sharps, no flats.
\DeclareMathOperator{\Sq}{Sq}
\DeclareMathOperator{\Cross}{Cr}
\DeclareMathOperator{\Steps}{St}
\DeclareMathOperator{\Cell}{Cell}
\DeclareMathOperator{\Art}{Art}
\DeclareMathOperator{\dom}{dom}
\DeclareMathOperator{\pos}{pos}
\DeclareMathOperator{\cut}{cut}
\DeclareMathOperator{\cox}{cox}
\DeclareMathOperator{\src}{src}
\DeclareMathOperator{\tgt}{tgt}
\newcommand{\RunOver}{\mathcal{R}}              % runs over a chain
\newcommand{\Pg}{\mathcal{P}}                   % a generic 2-polygraph
\newcommand{\ArtBraid}{\mathcal{A}}             % Artin's braid polygraph
\newcommand{\Polygraph}{\mathbf{Poly}}          % the category of 2-polygraphs
\newcommand{\pres}[1]{\left\langle #1 \right\rangle}
\newcommand{\symdiff}{\mathbin{\triangle}}
% \BraidPos already carries a superscript, so its opposite needs its own name.
\newcommand{\BraidPosOp}{\mathbf{Braid}^{+,\mathrm{op}}}

% --- Drafting -----------------------------------------------------------
% \gap{...} marks prose that is still to be written, and says what the
% paragraph has to communicate.  Grep for "\gap{" to find them all; delete
% this macro's body to typeset a clean copy.
\newcommand{\gap}[1]{%
  \par\smallskip\noindent
  \textcolor{BrickRed}{$\blacktriangleright$ \textit{#1}}\par\smallskip}

% --- Figure helpers: a run drawn as a monotone path through the blocks ---
% Each block of a chain is a cube; a run traverses each one by a monotone
% edge path, so a run is a route through a row of cubes.  Thin lines are the
% cubes' edges, the heavy line is the run.
\tikzset{
  te/.style  = {line width=0.4pt, black!45},
  rt/.style  = {line width=1.5pt, line cap=round, line join=round},
  ar/.style  = {->, >=Stealth, line width=0.5pt, black!75},
  gen/.style = {font=\scriptsize, inner sep=1.5pt},
  wd/.style  = {font=\scriptsize, inner sep=1.5pt},
  % the 2-cell filling a polygon of runs, drawn as a 2-category would
  twocell/.style = {line width=0.5pt, double distance=2pt,
                    -{Implies[length=3mm, width=3.2mm]}},
}
% A run of \bigvee[2,2]: the two blocks drawn flat, as squares standing on a
% diagonal, with the edges of the chain before and after them as a tail and a
% tip.  #1 shift; #2, #3 are .6 when the run fires that block's two events in
% order, taking the upper way round the square, and -.6 when it reverses them.
\newcommand{\PanelSqSq}[3]{%
  \begin{scope}[shift={#1}, scale=0.5]
    \draw[te] (-2.9,0)--(-2,0)--(-1,.6)--(0,0)--(1,.6)--(2,0)--(2.9,0);
    \draw[te] (-2,0)--(-1,-.6)--(0,0)--(1,-.6)--(2,0);
    \draw[rt] (-2.9,0)--(-2,0)--(-1,#2)--(0,0)--(1,#3)--(2,0)--(2.9,0);
  \end{scope}}
% A run of \bigvee[3]: the block drawn as a cube, initial vertex at the near
% bottom left and final vertex at the far top right, with the edges of the
% chain before and after it as a tail and a tip, so the block is visibly one
% bead of a chain.  #1 shift; #2, #3 name the two intermediate vertices of the
% run, from  x, y, z  (one axis used) and  xy, xz, yz  (two).
\newcommand{\PanelCube}[3]{%
  \begin{scope}[shift={#1}, scale=0.85]
    \coordinate (o)    at (-0.76,-0.76);
    \coordinate (x)    at ( 0.24,-0.76);
    \coordinate (y)    at (-0.24,-0.26);
    \coordinate (z)    at (-0.76, 0.26);
    \coordinate (xy)   at ( 0.76,-0.26);
    \coordinate (xz)   at ( 0.24, 0.26);
    \coordinate (yz)   at (-0.24, 0.76);
    \coordinate (xyz)  at ( 0.76, 0.76);
    \coordinate (tail) at (-1.46,-0.76);
    \coordinate (tip)  at ( 1.46, 0.76);
    \draw[te] (tail)--(o) (o)--(x) (o)--(z) (x)--(xy) (x)--(xz) (z)--(xz)
              (z)--(yz) (xy)--(xyz) (xz)--(xyz) (yz)--(xyz) (xyz)--(tip);
    \draw[te, densely dashed] (o)--(y) (y)--(xy) (y)--(yz);
    \draw[rt] (tail)--(o)--(#2)--(#3)--(xyz)--(tip);
  \end{scope}}

% The square a cover flips, shown on the arrow: a small copy with that face
% shaded.  \IconSqSq{shift}{-1 or 1} picks the first or second square;
% \IconCube{shift}{four corner names} shades that face of the cube.
\newcommand{\IconSqSq}[2]{%
  \begin{scope}[shift={#1}, scale=0.30]
    \fill[black!18] ({#2-1},0)--({#2},.6)--({#2+1},0)--({#2},-.6)--cycle;
    \draw[te] (-2,0)--(-1,.6)--(0,0)--(1,.6)--(2,0)--(1,-.6)--(0,0)--(-1,-.6)--(-2,0);
  \end{scope}}
\newcommand{\IconCube}[5]{%
  \begin{scope}[shift={#1}, scale=0.50]
    \coordinate (o)   at (-0.76,-0.76);   \coordinate (x)   at ( 0.24,-0.76);
    \coordinate (y)   at (-0.24,-0.26);   \coordinate (z)   at (-0.76, 0.26);
    \coordinate (xy)  at ( 0.76,-0.26);   \coordinate (xz)  at ( 0.24, 0.26);
    \coordinate (yz)  at (-0.24, 0.76);   \coordinate (xyz) at ( 0.76, 0.76);
    \fill[black!18] (#2)--(#3)--(#4)--(#5)--cycle;
    \draw[te] (o)--(x) (o)--(z) (x)--(xy) (x)--(xz) (z)--(xz) (z)--(yz)
              (xy)--(xyz) (xz)--(xyz) (yz)--(xyz);
    \draw[te, densely dashed] (o)--(y) (y)--(xy) (y)--(yz);
  \end{scope}}

% The 2-cell itself, in the same style as the 1-cells: for \bigvee[2,2] both
% squares shaded, for \bigvee[3] the whole cube.  These label the double arrow
% filling a polygon of runs.
\newcommand{\IconSqSqBoth}[1]{%
  \begin{scope}[shift={#1}, scale=0.30]
    \fill[black!18] (-2,0)--(-1,.6)--(0,0)--(-1,-.6)--cycle;
    \fill[black!18] (0,0)--(1,.6)--(2,0)--(1,-.6)--cycle;
    \draw[te] (-2,0)--(-1,.6)--(0,0)--(1,.6)--(2,0)--(1,-.6)--(0,0)--(-1,-.6)--(-2,0);
  \end{scope}}
\newcommand{\IconCubeFull}[1]{%
  \begin{scope}[shift={#1}, scale=0.50]
    \coordinate (o)   at (-0.76,-0.76);   \coordinate (x)   at ( 0.24,-0.76);
    \coordinate (y)   at (-0.24,-0.26);   \coordinate (z)   at (-0.76, 0.26);
    \coordinate (xy)  at ( 0.76,-0.26);   \coordinate (xz)  at ( 0.24, 0.26);
    \coordinate (yz)  at (-0.24, 0.76);   \coordinate (xyz) at ( 0.76, 0.76);
    \fill[black!18] (o)--(x)--(xy)--(xyz)--(yz)--(z)--cycle;
    \draw[te] (o)--(x) (o)--(z) (x)--(xy) (x)--(xz) (z)--(xz) (z)--(yz)
              (xy)--(xyz) (xz)--(xyz) (yz)--(xyz);
    \draw[te, densely dashed] (o)--(y) (y)--(xy) (y)--(yz);
  \end{scope}}
