#!/usr/bin/env bash
# Rebuild main.pdf from sources so the committed PDF always matches the
# committed .tex/.sty/.bib.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Only rebuild when sources are part of this commit.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(tex|sty|bib)$'; then
    exit 0
fi

# Build from the staged state: stash unstaged changes to tracked files so
# work-in-progress doesn't leak into the committed PDF.
if ! git diff --quiet; then
    git stash push --keep-index --quiet --message "pre-commit: isolate staged sources"
    trap 'git stash pop --quiet' EXIT
fi

echo "pre-commit: rebuilding main.pdf..."
make all >/dev/null

git add -- main.pdf
